import java.util.Arrays;

public class InsertAtEnd {
    public static void main(String[] args) {
        int[] arr = {10, 20, 30};

        int[] newArr = Arrays.copyOf(arr, arr.length + 1);
        newArr[newArr.length - 1] = 40;

        System.out.println(Arrays.toString(newArr));
    }
}